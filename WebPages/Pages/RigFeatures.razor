@page "/Rig/Features"
@inject ILogger<RigFeatures> Logger
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject RigApiClient RigApiClient

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <MudText Class="mt-4 mb-2" Typo="Typo.h6">Rig Features</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">Built-in capability catalogs are shared by every deployment. Custom catalogs can be added for local classifications.</MudText>
    <MudContainer Class="d-flex flex-row pa-0 mb-3">
        <MudButton Class="me-1" Variant="Variant.Filled" Color="Color.Success" OnClick="AddCategory">Add Category</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(!_selectedCategories.Any())" OnClick="DeleteSelectedCategoriesAsync">Delete</MudButton>
    </MudContainer>

    <MudGrid Class="mt-2">
        <MudItem xs="2" md="1" Class="d-flex align-center">
            <MudCheckBox T="bool" Value="@AreAllCategoriesSelected()" ValueChanged="@SetAllCategoriesSelected" />
        </MudItem>
        <MudItem xs="10" md="3" Class="d-flex align-center"><MudText Typo="Typo.subtitle2">Category</MudText></MudItem>
        <MudItem xs="6" md="1" Class="d-flex align-center"><MudText Typo="Typo.subtitle2">Exclusive</MudText></MudItem>
        <MudItem xs="6" md="1" Class="d-flex align-center"><MudText Typo="Typo.subtitle2">Dated</MudText></MudItem>
        <MudItem xs="10" md="5" Class="d-flex align-center"><MudText Typo="Typo.subtitle2">Options</MudText></MudItem>
        <MudItem xs="2" md="1" />
    </MudGrid>

    @foreach (RigFeatureCategory category in _categories)
    {
        <MudGrid Class="mt-2" @key="category">
            <MudItem xs="2" md="1" Class="d-flex align-center">
                <MudCheckBox T="bool" Disabled="@category.IsBuiltIn" Value="@IsCategorySelected(category)" ValueChanged="@((bool selected) => SetCategorySelected(category, selected))" />
            </MudItem>
            <MudItem xs="10" md="3">
                @if (category.IsBuiltIn)
                {
                    <MudText Typo="Typo.body1">@CategoryTitle(category)</MudText>
                    <MudText Typo="Typo.caption">@category.Description</MudText>
                }
                else
                {
                    <MudTextField @bind-Value="category.Name" Required="true" />
                    <MudTextField @bind-Value="category.Code" Label="Stable code" HelperText="Leave empty to derive it from the name" />
                    <MudTextField @bind-Value="category.Description" Label="Description" Lines="2" />
                    <MudCheckBox T="bool" @bind-Value="category.IsDeprecated" Label="Deprecated" Color="Color.Warning" />
                }
            </MudItem>
            <MudItem xs="6" md="1" Class="d-flex align-center">
                <MudCheckBox T="bool" Disabled="@category.IsBuiltIn" @bind-Value="category.IsExclusive" />
            </MudItem>
            <MudItem xs="6" md="1" Class="d-flex align-center">
                <MudCheckBox T="bool" Disabled="@category.IsBuiltIn" @bind-Value="category.HasValidityPeriod" />
            </MudItem>
            <MudItem xs="10" md="5">
                @if (category.IsBuiltIn)
                {
                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                        @foreach (RigFeatureOption option in category.Options ?? [])
                        {
                            <MudChip T="string" Size="Size.Small" Color="@(option.IsDeprecated ? Color.Default : Color.Primary)" Variant="Variant.Outlined">@option.Name</MudChip>
                        }
                    </MudStack>
                }
                else
                {
                    <MudContainer Class="d-flex flex-row align-center pa-0 mb-1">
                        <MudCheckBox T="bool" Value="@AreAllOptionsSelected(category)" ValueChanged="@((bool selected) => SetAllOptionsSelected(category, selected))" />
                        <MudButton Class="ms-1 me-1" Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" OnClick="@(() => AddOption(category))">Add Option</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="@(!HasSelectedOptions(category))" OnClick="@(() => DeleteSelectedOptions(category))">Delete</MudButton>
                    </MudContainer>
                    @foreach (RigFeatureOption option in category.Options ?? [])
                    {
                        <MudGrid @key="option" Class="mb-2">
                            <MudItem xs="1" Class="d-flex align-center"><MudCheckBox T="bool" Value="@IsOptionSelected(option)" ValueChanged="@((bool selected) => SetOptionSelected(option, selected))" /></MudItem>
                            <MudItem xs="11"><MudTextField @bind-Value="option.Name" Label="Name" Required="true" /></MudItem>
                            <MudItem xs="1" />
                            <MudItem xs="5"><MudTextField @bind-Value="option.Code" Label="Code" /></MudItem>
                            <MudItem xs="5"><MudTextField @bind-Value="option.Description" Label="Description" /></MudItem>
                            <MudItem xs="1" Class="d-flex align-center"><MudCheckBox T="bool" @bind-Value="option.IsDeprecated" Label="Deprecated" /></MudItem>
                        </MudGrid>
                    }
                }
            </MudItem>
            <MudItem xs="2" md="1" Class="d-flex align-center justify-end">
                @if (!category.IsBuiltIn)
                {
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => DeleteCategoryAsync(category))" />
                }
            </MudItem>
        </MudGrid>
    }

    <MudContainer Class="d-flex flex-row pa-0 mt-4">
        <MudButton Class="me-1" Variant="Variant.Filled" Color="Color.Success" OnClick="SaveAsync">Save</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">Reload</MudButton>
    </MudContainer>
}

@code {
    private List<RigFeatureCategory> _categories = [];
    private bool _loading = true;
    private readonly HashSet<RigFeatureCategory> _selectedCategories = [];
    private readonly HashSet<RigFeatureOption> _selectedOptions = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;
            _categories = (await RigApiClient.GetRigFeatureCategoriesAsync())
                .OrderByDescending(value => value.IsBuiltIn)
                .ThenBy(value => value.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            _selectedCategories.Clear();
            _selectedOptions.Clear();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load rig feature categories");
            Snackbar.Add("Failed to load rig feature categories.", Severity.Error);
        }
        finally { _loading = false; }
    }

    private void AddCategory() => _categories.Add(new RigFeatureCategory
    {
        MetaInfo = new OSDC.Drilling.Rig.ModelShared.MetaInfo(), Name = "New rig feature category", Options = new List<RigFeatureOption> { new() { Name = "New option" } }
    });

    private static void AddOption(RigFeatureCategory category)
    {
        category.Options ??= new List<RigFeatureOption>();
        category.Options.Add(new RigFeatureOption { Name = "New option" });
    }

    private static void RemoveOption(RigFeatureCategory category, RigFeatureOption option) => category.Options?.Remove(option);

    private void DeleteSelectedOptions(RigFeatureCategory category)
    {
        if (category.Options == null) return;
        foreach (RigFeatureOption option in category.Options.Where(_selectedOptions.Contains).ToList())
        {
            category.Options.Remove(option);
            _selectedOptions.Remove(option);
        }
    }

    private async Task SaveAsync()
    {
        foreach (RigFeatureCategory category in _categories.Where(category => !category.IsBuiltIn).ToList())
        {
            await SaveCategoryAsync(category);
        }
        await LoadAsync();
    }

    private async Task SaveCategoryAsync(RigFeatureCategory category)
    {
        if (string.IsNullOrWhiteSpace(category.Name) || category.Options == null || category.Options.Count == 0 || category.Options.Any(value => string.IsNullOrWhiteSpace(value.Name)))
        {
            Snackbar.Add("A category needs a name and at least one named option.", Severity.Warning);
            return;
        }
        try
        {
            RigFeatureCategory saved = category.MetaInfo?.ID == Guid.Empty
                ? await RigApiClient.CreateRigFeatureCategoryAsync(category)
                : await RigApiClient.UpdateRigFeatureCategoryAsync(category);
            int index = _categories.IndexOf(category);
            _categories[index] = saved;
            Snackbar.Add("Rig feature category saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save rig feature category");
            Snackbar.Add("The category could not be saved. Reload if another user may have changed it.", Severity.Error);
        }
    }

    private async Task DeleteCategoryAsync(RigFeatureCategory category)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete",
            $"Delete rig feature category '{category.Name ?? "Custom category"}'?",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall });
        if (confirmed != true) return;
        if (category.MetaInfo?.ID == Guid.Empty)
        {
            _categories.Remove(category);
            _selectedCategories.Remove(category);
            return;
        }
        try
        {
            HttpStatusCode status = await RigApiClient.DeleteRigFeatureCategoryAsync(category.MetaInfo!.ID);
            if (status == HttpStatusCode.OK) { _categories.Remove(category); _selectedCategories.Remove(category); Snackbar.Add("Rig feature category deleted.", Severity.Success); }
            else Snackbar.Add("The category is built-in or still assigned to a rig and cannot be deleted.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete rig feature category");
            Snackbar.Add("The category could not be deleted.", Severity.Error);
        }
    }

    private async Task DeleteSelectedCategoriesAsync()
    {
        foreach (RigFeatureCategory category in _categories.Where(_selectedCategories.Contains).ToList())
        {
            await DeleteCategoryAsync(category);
        }
    }

    private bool IsCategorySelected(RigFeatureCategory category) => _selectedCategories.Contains(category);
    private void SetCategorySelected(RigFeatureCategory category, bool selected)
    {
        if (category.IsBuiltIn) return;
        if (selected) _selectedCategories.Add(category);
        else _selectedCategories.Remove(category);
    }
    private bool AreAllCategoriesSelected()
    {
        List<RigFeatureCategory> editable = _categories.Where(category => !category.IsBuiltIn).ToList();
        return editable.Count > 0 && editable.All(_selectedCategories.Contains);
    }
    private void SetAllCategoriesSelected(bool selected)
    {
        _selectedCategories.Clear();
        if (selected)
        {
            foreach (RigFeatureCategory category in _categories.Where(category => !category.IsBuiltIn))
                _selectedCategories.Add(category);
        }
    }
    private bool IsOptionSelected(RigFeatureOption option) => _selectedOptions.Contains(option);
    private void SetOptionSelected(RigFeatureOption option, bool selected)
    {
        if (selected) _selectedOptions.Add(option);
        else _selectedOptions.Remove(option);
    }
    private bool HasSelectedOptions(RigFeatureCategory category) => category.Options?.Any(_selectedOptions.Contains) == true;
    private bool AreAllOptionsSelected(RigFeatureCategory category) => category.Options?.Count > 0 && category.Options.All(_selectedOptions.Contains);
    private void SetAllOptionsSelected(RigFeatureCategory category, bool selected)
    {
        if (category.Options == null) return;
        foreach (RigFeatureOption option in category.Options) SetOptionSelected(option, selected);
    }

    private static string CategoryTitle(RigFeatureCategory category) => category.IsBuiltIn ? $"{category.Name} (built-in)" : category.Name ?? "Custom category";
}
