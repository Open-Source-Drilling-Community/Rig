@page "/StatisticsRig"
@inject ILogger<StatisticsRig> Logger
@inject ISnackbar Snackbar
@inject RigApiClient RigApiClient

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-4">
        <div>
            <MudText Typo="Typo.h5"><strong>Usage Statistics</strong></MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Rig requests retained across service restarts by the persistent service data volume.
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@_isLoading"
                   OnClick="RefreshAsync">
            Refresh
        </MudButton>
    </MudStack>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_statistics == null)
    {
        <MudAlert Severity="Severity.Warning">Unable to load Rig usage statistics.</MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2">Total requests</MudText>
                <MudText Typo="Typo.h6">@_totalCount</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2">GET requests</MudText>
                <MudText Typo="Typo.h6">@_getRequestCount</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2">POST requests</MudText>
                <MudText Typo="Typo.h6">@_postRequestCount</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2">PUT / DELETE requests</MudText>
                <MudText Typo="Typo.h6">@_putDeleteRequestCount</MudText>
            </MudItem>
        </MudGrid>

        <MudTable Items="_entries" Dense="true" Hover="true" Bordered="true" Striped="true" SortLabel="Sort by" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<StatisticsEntry, string>(entry => entry.Method)">Method</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<StatisticsEntry, string>(entry => entry.Operation)">Endpoint / operation</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<StatisticsEntry, object>(entry => entry.TotalCount)">Total</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Method">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@MethodColor(context.Method)">
                        @context.Method
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Endpoint / operation">@context.Operation</MudTd>
                <MudTd DataLabel="Total">@context.TotalCount</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No usage counters were returned by the Rig service.</MudText>
            </NoRecordsContent>
        </MudTable>

    }
</MudStack>

@code {
    private UsageStatisticsRig? _statistics;
    private readonly List<StatisticsEntry> _entries = new();
    private long _totalCount;
    private long _getRequestCount;
    private long _postRequestCount;
    private long _putDeleteRequestCount;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _isLoading = true;
        try
        {
            _statistics = await RigApiClient.GetUsageStatisticsAsync();
            BuildStatistics();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load usage statistics");
            _statistics = null;
            ResetStatistics();
            Snackbar.Add("Failed to load usage statistics.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BuildStatistics()
    {
        ResetStatistics();
        if (_statistics == null)
        {
            return;
        }

        AddEntry("GET", "/Rig", _statistics.GetAllRigIdPerDay);
        AddEntry("GET", "/Rig/MetaInfo", _statistics.GetAllRigMetaInfoPerDay);
        AddEntry("GET", "/Rig/{id}", _statistics.GetRigByIdPerDay);
        AddEntry("GET", "/Rig/LightData", _statistics.GetAllRigLightPerDay);
        AddEntry("GET", "/Rig/HeavyData", _statistics.GetAllRigPerDay);
        AddEntry("POST", "/Rig", _statistics.PostRigPerDay);
        AddEntry("PUT", "/Rig/{id}", _statistics.PutRigByIdPerDay);
        AddEntry("DELETE", "/Rig/{id}", _statistics.DeleteRigByIdPerDay);
        AddEntry("POST", "/Rig/BatchExport", _statistics.BatchExportRigsPerDay);
        AddEntry("POST", "/Rig/BatchRestore", _statistics.BatchRestoreRigsPerDay);

        _totalCount = _entries.Aggregate<StatisticsEntry, long>(0, (sum, entry) => sum + entry.TotalCount);
        _getRequestCount = TotalFor("GET");
        _postRequestCount = TotalFor("POST");
        _putDeleteRequestCount = TotalFor("PUT") + TotalFor("DELETE");
    }

    private void ResetStatistics()
    {
        _entries.Clear();
        _totalCount = 0;
        _getRequestCount = 0;
        _postRequestCount = 0;
        _putDeleteRequestCount = 0;
    }

    private void AddEntry(string method, string operation, History? history)
    {
        _entries.Add(new StatisticsEntry
        {
            Method = method,
            Operation = operation,
            TotalCount = history?.Data?.Aggregate<CountPerDay, long>(0, (sum, point) => sum + point.Count) ?? 0
        });
    }

    private long TotalFor(string method) =>
        _entries.Where(entry => entry.Method == method).Sum(entry => entry.TotalCount);

    private static Color MethodColor(string method) => method switch
    {
        "GET" => Color.Info,
        "POST" => Color.Success,
        "PUT" => Color.Warning,
        "DELETE" => Color.Error,
        _ => Color.Default
    };

    private sealed class StatisticsEntry
    {
        public string Method { get; init; } = string.Empty;
        public string Operation { get; init; } = string.Empty;
        public long TotalCount { get; init; }
    }
}
